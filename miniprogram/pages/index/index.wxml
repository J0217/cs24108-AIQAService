<!--pages/index/index.wxml-->
<view class="container">
  <!-- 用户信息区 -->
  <view class="user-section" wx:if="{{isLoggedIn}}">
    <view class="user-info">
      <view class="avatar user-avatar">👤</view>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
        <text class="welcome">您好，欢迎使用AI智能客服</text>
      </view>
    </view>
    <view class="announcement-badge" wx:if="{{announcementCount > 0}}" bindtap="goToAnnouncement">
      <text class="badge-count">{{announcementCount}}</text>
      <text class="badge-text">新公告</text>
    </view>
  </view>

  <!-- 未登录状态 -->
  <view class="login-section" wx:else>
    <view class="login-content">
      <view class="logo logo-emoji">🤖</view>
      <text class="title">AI智能问答客服平台</text>
      <text class="subtitle">智能对话 · 即时响应 · 贴心服务</text>
      <button class="btn-login" bindtap="wxLogin" loading="{{loading}}">
        微信一键登录
      </button>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="features">
    <view class="feature-item" bindtap="goToChat" data-scene="general">
      <view class="feature-icon chat-icon">💬</view>
      <text class="feature-name">智能对话</text>
      <text class="feature-desc">7×24小时在线解答</text>
    </view>
    <view class="feature-item" bindtap="goToChat" data-scene="ordering">
      <view class="feature-icon order-icon">📦</view>
      <text class="feature-name">订单查询</text>
      <text class="feature-desc">实时跟踪物流状态</text>
    </view>
    <view class="feature-item" bindtap="goToChat" data-scene="after_sales">
      <view class="feature-icon service-icon">🎧</view>
      <text class="feature-name">售后服务</text>
      <text class="feature-desc">专业客服为您服务</text>
    </view>
    <view class="feature-item" bindtap="goToChat" data-scene="technical">
      <view class="feature-icon tech-icon">🔧</view>
      <text class="feature-name">技术支持</text>
      <text class="feature-desc">技术难题快速解决</text>
    </view>
    <view class="feature-item" bindtap="goToAnnouncement">
      <view class="feature-icon notice-icon">📢</view>
      <text class="feature-name">公告中心</text>
      <text class="feature-desc">活动与服务通知</text>
    </view>
  </view>

  <!-- 快捷问题 -->
  <view class="quick-questions">
    <text class="section-title">常见问题</text>
    <view class="question-list">
      <view class="question-item" bindtap="goToChat" data-question="如何查询订单？">
        <text>📋</text>
        <text>如何查询订单？</text>
      </view>
      <view class="question-item" bindtap="goToChat" data-question="退换货政策是什么？">
        <text>🔄</text>
        <text>退换货政策是什么？</text>
      </view>
      <view class="question-item" bindtap="goToChat" data-question="如何联系客服？">
        <text>📞</text>
        <text>如何联系客服？</text>
      </view>
    </view>
  </view>
</view>
