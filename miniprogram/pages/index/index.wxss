/* pages/index/index.wxss */
.container {
  padding: 0;
  background: linear-gradient(180deg, #f8f9ff 0%, #f5f5f5 100%);
  min-height: 100vh;
}

/* 用户信息区 */
.user-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  margin-right: 20rpx;
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  font-size: 40rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.nickname {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.welcome {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.announcement-badge {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.badge-count {
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 8rpx;
}

.badge-text {
  color: #fff;
  font-size: 24rpx;
}

/* 登录区 */
.login-section {
  padding: 100rpx 40rpx;
  text-align: center;
}

.login-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.logo-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.btn-login {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
}

.btn-login::after {
  border: none;
}

/* 功能入口 */
.features {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.feature-item {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
}

.feature-item:not(:nth-child(2n)) {
  border-right: 1rpx solid #f0f0f0;
}

.feature-item:not(:nth-child(-n+2)) {
  border-top: 1rpx solid #f0f0f0;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.chat-icon { background: #e3f2fd; }
.order-icon { background: #fff3e0; }
.service-icon { background: #e8f5e9; }
.tech-icon { background: #fce4ec; }
.notice-icon { background: #ede7f6; }

.feature-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #999;
}

/* 快捷问题 */
.quick-questions {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.question-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.question-item text:first-child {
  margin-right: 16rpx;
  font-size: 32rpx;
}
