/* pages/chat/chat.wxss */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 头部 */
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.header-left {
  display: flex;
  align-items: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-right: 20rpx;
}

.scene-tag {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
}

.header-right {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.help-icon {
  width: 40rpx;
  height: 40rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  text-align: center;
  opacity: 0.6;
}

/* 场景选择器 */
.scene-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.picker-header text:first-child {
  font-size: 32rpx;
  font-weight: 600;
}

.close-btn {
  font-size: 36rpx;
  color: #999;
}

.picker-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.picker-item {
  width: calc(50% - 10rpx);
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.picker-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.scene-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.scene-name {
  font-size: 28rpx;
}

/* 消息列表 */
.message-list {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.message-wrapper {
  margin-bottom: 30rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
}

.user-message {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin: 0 16rpx;
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e3f2fd;
  font-size: 36rpx;
}

.message-bubble {
  max-width: 70%;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-wrap: break-word;
}

.user-bubble {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-top-right-radius: 8rpx;
}

.ai-bubble {
  background: #fff;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
  border-top-left-radius: 8rpx;
}

.ai-avatar {
  width: 40rpx;
  height: 40rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.message-content {
  white-space: pre-wrap;
}

.message-meta {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.quick-reply-tag {
  font-size: 20rpx;
  color: #667eea;
  background: #eef0ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.confidence {
  font-size: 20rpx;
  color: #999;
}

/* 打字指示器 */
.typing-indicator {
  display: flex;
  margin-bottom: 30rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 28rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #999;
  border-radius: 50%;
  animation: bounce 1.4s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 空状态 */
.empty-messages {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 快捷问题 */
.quick-questions {
  background: #fff;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.quick-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-item {
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.quick-item:active {
  background: #e8e8e8;
}

/* 输入区 */
.input-area {
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.message-input {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.send-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  padding: 0;
  border: none;
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  opacity: 0.5;
}
