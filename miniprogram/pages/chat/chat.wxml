<!--pages/chat/chat.wxml-->
<view class="chat-container">
  <!-- 头部 -->
  <view class="chat-header">
    <view class="header-left">
      <text class="header-title">AI智能客服</text>
      <view class="scene-tag" bindtap="toggleScenePicker">
        <text>{{currentSceneName}}</text>
        <text class="arrow">▼</text>
      </view>
    </view>
    <view class="header-right">
      <view class="header-icon" bindtap="toggleHistory">🗂</view>
      <view class="header-icon" bindtap="toggleHelp">❓</view>
    </view>
  </view>

  <!-- 场景选择器 -->
  <view class="scene-picker" wx:if="{{showScenePicker}}">
    <view class="picker-mask" bindtap="toggleScenePicker"></view>
    <view class="picker-content">
      <view class="picker-header">
        <text>选择场景</text>
        <text class="close-btn" bindtap="toggleScenePicker">✕</text>
      </view>
      <view class="picker-list">
        <view
          class="picker-item {{currentScene === scene.type ? 'active' : ''}}"
          wx:for="{{scenes}}"
          wx:key="type"
          bindtap="handleSceneChange"
          data-scene="{{scene.type}}"
        >
          <text class="scene-icon">{{scene.icon}}</text>
          <text class="scene-name">{{scene.name}}</text>
        </view>
      </view>
      <text class="picker-tip">切换场景会开启一段新的会话，历史对话仍会保留</text>
    </view>
  </view>

  <!-- 历史会话抽屉 -->
  <view class="history-drawer" wx:if="{{showHistory}}">
    <view class="picker-mask" bindtap="toggleHistory"></view>
    <view class="history-panel">
      <view class="history-header">
        <text class="history-title">历史会话</text>
        <text class="close-btn" bindtap="toggleHistory">✕</text>
      </view>
      <view class="new-chat-btn" bindtap="startNewConversation">＋ 新建对话</view>
      <scroll-view class="history-list" scroll-y>
        <view
          class="history-item {{item.active ? 'active' : ''}}"
          wx:for="{{conversations}}"
          wx:key="id"
          bindtap="selectConversation"
          data-id="{{item.id}}"
        >
          <view class="history-item-main">
            <text class="history-item-icon">{{item.sceneIcon}}</text>
            <view class="history-item-text">
              <text class="history-item-title">{{item.title}}</text>
              <text class="history-item-meta">{{item.sceneName}} · {{item.message_count}} 条提问</text>
            </view>
          </view>
          <text class="history-item-del" catchtap="deleteConversation" data-id="{{item.id}}">删除</text>
        </view>
        <view class="history-empty" wx:if="{{conversations.length === 0}}">
          <text>暂无历史会话</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 帮助弹窗 -->
  <view class="help-modal" wx:if="{{showHelp}}">
    <view class="picker-mask" bindtap="toggleHelp"></view>
    <view class="help-card">
      <text class="help-title">使用帮助</text>
      <view class="help-line">1. 顶部场景标签可切换业务场景，切换后开启新会话</view>
      <view class="help-line">2. 右上角 🗂 可查看和继续历史对话</view>
      <view class="help-line">3. 回复气泡上的「智能模板 / 置信度」表示回答来源与可信度</view>
      <view class="help-line">4. 置信度较低时可点击「重新生成」或联系人工客服</view>
      <view class="help-phone" bindtap="copyServicePhone">客服热线 400-800-1234（9:00-21:00）· 点击复制</view>
      <view class="help-close" bindtap="toggleHelp">知道了</view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="message-list"
    id="messageList"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
  >
    <view class="message-wrapper" id="msg-{{item.id}}" wx:for="{{messages}}" wx:key="id">
      <!-- 用户消息 -->
      <view class="message-item user-message" wx:if="{{item.role === 'user'}}">
        <view class="avatar user-avatar">👤</view>
        <view class="message-bubble user-bubble">
          <text class="message-content">{{item.content}}</text>
        </view>
      </view>

      <!-- AI消息 -->
      <view class="message-item ai-message" wx:else>
        <view class="message-bubble ai-bubble">
          <view class="ai-avatar">🤖</view>
          <view class="message-content">{{item.content}}</view>
          <view class="message-meta">
            <text class="quick-reply-tag" wx:if="{{item.is_quick_reply}}">智能模板</text>
            <text class="confidence" wx:if="{{item.confidencePercent}}">✓ 置信度 {{item.confidencePercent}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载中状态 -->
    <view class="typing-indicator" wx:if="{{typing}}">
      <view class="ai-bubble">
        <view class="ai-avatar">🤖</view>
        <view class="typing-dots">
          <text class="dot"></text>
          <text class="dot"></text>
          <text class="dot"></text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-messages" wx:if="{{messages.length === 0}}">
      <view class="empty-icon">💬</view>
      <text class="empty-text">开始对话吧！</text>
      <text class="empty-hint">AI助手24小时为您服务</text>
    </view>
  </scroll-view>

  <!-- 快捷问题 -->
  <view class="quick-questions" wx:if="{{messages.length === 0 && quickQuestions.length > 0}}">
    <text class="quick-title">热门问题</text>
    <view class="quick-list">
      <view
        class="quick-item"
        wx:for="{{quickQuestions}}"
        wx:key="*this"
        bindtap="handleQuickQuestion"
        data-question="{{item}}"
      >{{item}}</view>
    </view>
  </view>

  <!-- 发送失败提示 -->
  <view class="failed-tip" wx:if="{{failedContent}}">
    <text class="failed-text">上一条消息发送失败</text>
    <text class="failed-retry" bindtap="retrySend">重新发送</text>
  </view>

  <!-- 输入区 -->
  <view class="input-area">
    <view class="input-wrapper">
      <input
        class="message-input"
        type="text"
        placeholder="请输入您的问题..."
        value="{{inputValue}}"
        bindinput="handleInput"
        bindconfirm="handleConfirm"
        confirm-type="send"
        maxlength="500"
      />
      <button class="send-btn" bindtap="handleSend" loading="{{isSending}}" disabled="{{!canSend}}">
        发送
      </button>
    </view>
  </view>
</view>
