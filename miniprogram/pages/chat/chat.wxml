<!--pages/chat/chat.wxml-->
<view class="chat-container">
  <!-- 头部 -->
  <view class="chat-header">
    <view class="header-left">
      <text class="header-title">AI智能客服</text>
      <view class="scene-tag" bindtap="toggleScenePicker">
        <text>{{currentSceneName}}</text>
        <text class="arrow">▼</text>
      </view>
    </view>
    <view class="header-right">
      <image class="help-icon" src="/static/icons/help.png" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 场景选择器 -->
  <view class="scene-picker" wx:if="{{showScenePicker}}">
    <view class="picker-mask" bindtap="toggleScenePicker"></view>
    <view class="picker-content">
      <view class="picker-header">
        <text>选择场景</text>
        <text class="close-btn" bindtap="toggleScenePicker">✕</text>
      </view>
      <view class="picker-list">
        <view
          class="picker-item {{currentScene === scene.type ? 'active' : ''}}"
          wx:for="{{scenes}}"
          wx:key="type"
          bindtap="handleSceneChange"
          data-scene="{{scene.type}}"
        >
          <text class="scene-icon">{{scene.icon}}</text>
          <text class="scene-name">{{scene.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="message-list"
    id="messageList"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
  >
    <view class="message-wrapper" wx:for="{{messages}}" wx:key="id">
      <!-- 用户消息 -->
      <view class="message-item user-message" wx:if="{{item.role === 'user'}}">
        <image class="avatar" src="{{userInfo.avatar || '/static/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="message-bubble user-bubble">
          <text class="message-content">{{item.content}}</text>
        </view>
      </view>

      <!-- AI消息 -->
      <view class="message-item ai-message" wx:else>
        <view class="message-bubble ai-bubble">
          <view class="ai-avatar">🤖</view>
          <view class="message-content">{{item.content}}</view>
          <view class="message-meta" wx:if="{{item.confidence}}">
            <text class="confidence">✓ 置信度: {{item.confidence * 100 | toPercent}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载中状态 -->
    <view class="typing-indicator" wx:if="{{typing}}">
      <view class="ai-bubble">
        <view class="ai-avatar">🤖</view>
        <view class="typing-dots">
          <text class="dot"></text>
          <text class="dot"></text>
          <text class="dot"></text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-messages" wx:if="{{messages.length === 0}}">
      <view class="empty-icon">💬</view>
      <text class="empty-text">开始对话吧！</text>
      <text class="empty-hint">AI助手24小时为您服务</text>
    </view>
  </scroll-view>

  <!-- 快捷问题 -->
  <view class="quick-questions" wx:if="{{messages.length === 0}}">
    <text class="quick-title">热门问题</text>
    <view class="quick-list">
      <view class="quick-item" bindtap="handleQuickQuestion" data-question="如何查询订单？">如何查询订单？</view>
      <view class="quick-item" bindtap="handleQuickQuestion" data-question="退换货政策">退换货政策</view>
      <view class="quick-item" bindtap="handleQuickQuestion" data-question="联系客服">联系客服</view>
      <view class="quick-item" bindtap="handleQuickQuestion" data-question="产品使用问题">产品使用问题</view>
    </view>
  </view>

  <!-- 输入区 -->
  <view class="input-area">
    <view class="input-wrapper">
      <input
        class="message-input"
        type="text"
        placeholder="请输入您的问题..."
        value="{{inputValue}}"
        bindinput="handleInput"
        bindconfirm="handleConfirm"
        confirm-type="send"
        maxlength="500"
      />
      <button class="send-btn" bindtap="handleSend" loading="{{isSending}}" disabled="{{!inputValue.trim() || isSending}}">
        发送
      </button>
    </view>
  </view>
</view>
