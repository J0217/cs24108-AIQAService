<!--pages/announcement/announcement.wxml-->
<view class="page">
  <view class="page-header">
    <text class="page-title">公告中心</text>
    <text class="unread-badge" wx:if="{{unreadCount > 0}}">{{unreadCount}} 条未读</text>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view class="empty" wx:elif="{{announcements.length === 0}}">
    <text class="empty-icon">📭</text>
    <text>暂无公告</text>
  </view>

  <view class="list" wx:else>
    <view
      class="card {{expandedId === item.id ? 'expanded' : ''}}"
      wx:for="{{announcements}}"
      wx:key="id"
      bindtap="toggleDetail"
      data-id="{{item.id}}"
    >
      <view class="card-head">
        <view class="card-tags">
          <text class="tag tag-{{item.type}}">{{item.typeLabel}}</text>
          <text class="tag tag-priority" wx:if="{{item.priority >= 10}}">置顶</text>
        </view>
        <text class="card-date">{{item.dateText}}</text>
      </view>
      <text class="card-title">{{item.title}}</text>
      <text class="card-summary" wx:if="{{expandedId !== item.id}}">{{item.content}}</text>
      <text class="card-content" wx:else>{{item.content}}</text>
      <view class="card-foot" wx:if="{{expandedId === item.id}}">
        <text class="card-meta">发布人：{{item.creator_name || '系统'}} · 浏览 {{item.view_count}} 次</text>
      </view>
      <text class="card-arrow">{{expandedId === item.id ? '收起' : '展开全文'}}</text>
    </view>
  </view>
</view>
