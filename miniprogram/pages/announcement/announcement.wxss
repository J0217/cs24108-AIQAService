/* pages/announcement/announcement.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding: 30rpx;
  box-sizing: border-box;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
}

.unread-badge {
  font-size: 22rpx;
  color: #fff;
  background: #e05a5a;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.loading,
.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 90rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.card-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  color: #5b6ee1;
  background: #eef0ff;
}

.tag-promotion {
  color: #d97706;
  background: #fff7e6;
}

.tag-system {
  color: #059669;
  background: #e9f9f2;
}

.tag-priority {
  color: #e05a5a;
  background: #fff0f0;
}

.card-date {
  font-size: 22rpx;
  color: #aaa;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.5;
}

.card-summary,
.card-content {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.card-summary {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-foot {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eee;
}

.card-meta {
  font-size: 22rpx;
  color: #aaa;
}

.card-arrow {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #5b6ee1;
  text-align: right;
}
